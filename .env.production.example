APP_ENV=production
API_ADDR=:8080
DATABASE_URL=postgres://control_propiedades:CHANGE_PASSWORD@postgres:5432/control_propiedades?sslmode=disable
DATABASE_MAX_CONNS=10
SHUTDOWN_TIMEOUT=10s
WEB_ORIGIN=https://YOUR_DOMAIN.com
SESSION_TTL=168h
SESSION_COOKIE_NAME=cp_session
MAX_UPLOAD_BYTES=52428800

POSTGRES_DB=control_propiedades
POSTGRES_USER=control_propiedades
POSTGRES_PASSWORD=CHANGE_PASSWORD

MINIO_ROOT_USER=control_propiedades
MINIO_ROOT_PASSWORD=CHANGE_MINIO_PASSWORD
MINIO_BUCKET=control-propiedades
MINIO_ENDPOINT=minio:9000

STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=control_propiedades
STORAGE_SECRET_KEY=CHANGE_MINIO_PASSWORD
STORAGE_BUCKET=control-propiedades
STORAGE_USE_SSL=false

NEXT_PUBLIC_API_BASE_URL=https://YOUR_DOMAIN.com
API_INTERNAL_URL=http://api:8080

BACKUP_RETENTION_DAYS=7
